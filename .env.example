# Football data provider. "snapshot" uses the verified, dated JSON snapshot in src/data.
# A live provider would run behind a server proxy — never put its API key in a VITE_ variable.
VITE_DATA_PROVIDER=snapshot

# true = only CC/original media (for a public deployment). false = also allow restricted media in public/media/restricted.
VITE_PUBLIC_SAFE=true

# Absolute site URL used for canonical/Open Graph tags.
VITE_SITE_URL=http://localhost:5173
